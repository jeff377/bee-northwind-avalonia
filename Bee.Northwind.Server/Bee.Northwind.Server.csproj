<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bee.Northwind.Server</RootNamespace>
    <AssemblyName>Bee.Northwind.Server</AssemblyName>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Wiring for the framework convention analyzers (BEE1xxx / BEE2xxx), which check this
    application's real definition files at build time. Two parts, and each is silent when missing.

    Bee.Definition is referenced directly, which since 4.22.0 is no longer required: the targets
    that inject the definition files now ship in buildTransitive/, so they reach a project that
    only pulls Bee.Definition in transitively. Up to 4.21.0 they shipped in build/, which NuGet
    imports for a direct reference only — without that import the analyzer loaded, found no files
    to read, and every definition rule was inert with nothing saying so. The explicit reference is
    kept because this project names the dependency it actually compiles against.

    BeeDefinitionFilesGlob then says where the definitions actually are. The glob those targets
    inject is rooted at the project directory, so that a multi-project solution does not rescan the
    same tree once per project; this solution keeps its definitions at the root, one level up.
  -->
  <PropertyGroup>
    <BeeDefinitionFilesGlob>..\Define\**\*.xml</BeeDefinitionFilesGlob>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bee.Definition" Version="4.31.0" />
    <PackageReference Include="Bee.Api.AspNetCore" Version="4.31.0" />
    <PackageReference Include="Bee.Business" Version="4.31.0" />
    <PackageReference Include="Bee.Db" Version="4.31.0" />
    <PackageReference Include="Bee.Hosting" Version="4.31.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.4" />
    <!-- Force SQLitePCLRaw native bundle to 3.x (non-vulnerable SQLite engine); the 2.1.x
         line carries advisory GHSA-2m69-gcr7-jv3q with no 2.x patch. Microsoft.Data.Sqlite
         9.0.4 would otherwise pull 2.1.x transitively. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Northwind seed subset read by NorthwindSchemaSeeder at first run. The Web SDK
         already globs these as Content; only override the copy-to-output behaviour. -->
    <Content Update="SeedData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
